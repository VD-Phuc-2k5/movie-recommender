# Optional: defaults to local[2], which is safer for MovieLens 32M on local machines.
# Raise this only when the machine has sufficient memory for more concurrent Spark tasks.
SPARK_MASTER=local[2]

# Heap available to the local Spark driver. MovieLens 32M ALS needs more than Spark's 1g default.
SPARK_DRIVER_MEMORY=4g

# Enables response caching; Redis Stack is required for vector ANN.
REDIS_URL=redis://localhost:6379/0

# Comma-separated browser origins allowed to call FastAPI.
CORS_ORIGINS=http://localhost:3000
